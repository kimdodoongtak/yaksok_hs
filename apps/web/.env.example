# 호스트 Node.js 24에서 앱을 실행할 때 apps/web/.env로 복사한다.
# Docker tools에서는 Compose가 db:5432 연결 값을 제공하므로 복사할 필요가 없다.
DATABASE_URL=postgresql://sdd:local-only-password@localhost:55433/sdd
DIRECT_URL=postgresql://sdd:local-only-password@localhost:55433/sdd

# Vercel에서는 환경별 Neon 값을 직접 설정한다.
# DATABASE_URL: 풀링 연결 주소 / DIRECT_URL: 같은 DB의 직접 연결 주소
# Neon CLI의 .env.local을 사용하면 DATABASE_URL_UNPOOLED를 직접 연결로 사용한다.
# DIRECT_URL이 주입되어 있으면 그것을 우선한다. Docker의 로컬 DB 설정은 유지된다.
# 호스트 DB 포트를 바꿨다면 위 두 URL의 포트도 함께 바꾼다.
